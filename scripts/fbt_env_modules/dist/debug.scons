Import("FW_ENV", "DIST_ENV")
distenv, firmware_env = DIST_ENV, FW_ENV

debug_env = distenv.Clone(
    tools=["fbt_debugopts"],
    HW_CONFIG_FILE=firmware_env["HW_CONFIG_FILE"],
    HW_DEBUG_EXTENSIONS_DIR=firmware_env["HW_DEBUG_EXTENSIONS_DIR"],
)

__base_debug_opts = [
    "--root",
    "${FBT_DEBUG_DIR}",
    "--serial",
    "${DEBUG_INTERFACE_SERIAL}",
    "--platform",
    "${HW_CONFIG_FILE}",
    "--init",
]

_target_debug_tags = FW_ENV["TARGET_CFG"].extra_target_meta.get("debug_tags", ())

if "svd" in _target_debug_tags:
    __base_debug_opts.append("--with-svd")

if "fwversion" in _target_debug_tags:
    __base_debug_opts.append("--with-fwversion")

if debug_env["HW_DEBUG_EXTENSIONS_DIR"] is not None:
    __base_debug_opts.append("--user-extensions")
    __base_debug_opts.append("${HW_DEBUG_EXTENSIONS_DIR}")


# Debugging firmware
firmware_debug = debug_env.PhonyTarget(
    "debug",
    [
        [
            "${PYTHON3}",
            "${FBT_DEBUG_SCRIPT}",
            *__base_debug_opts,
            "${SOURCE.abspath}",
            "--compare",
            "--with-rtos" if "rtos" in _target_debug_tags else None,
            *(
                ["--with-apps", firmware_env["FBT_FAP_DEBUG_ELF_ROOT"]]
                if "apps" in _target_debug_tags
                else ()
            ),
        ],
    ],
    source=firmware_env["FW_ELF"],
)

if firmware_flash := distenv.get("FW_FLASH"):
    debug_env.Depends(firmware_debug, firmware_flash)


# Debug alien elf
debug_env.PhonyTarget(
    "debug_other",
    [
        [
            "${PYTHON3}",
            "${FBT_DEBUG_SCRIPT}",
            *__base_debug_opts,
            "${SOURCE.abspath}" if firmware_env["OTHER_ELF"] else None,
        ],
    ],
    source=firmware_env["OTHER_ELF"] if firmware_env["OTHER_ELF"] else None,
)

# Backtrace all threads (supports OTHER_ELF to override FW_ELF)
debug_env.PhonyTarget(
    "gdb_trace_all",
    [
        [
            "${PYTHON3}",
            "${FBT_DEBUG_SCRIPT}",
            *__base_debug_opts,
            "--batch",
            "${SOURCE.abspath}",
            "--with-rtos" if "rtos" in _target_debug_tags else None,
            "-ex",
            "thread apply all bt",
            "-ex",
            "quit",
        ],
    ],
    source=(
        firmware_env["OTHER_ELF"]
        if firmware_env["OTHER_ELF"]
        else firmware_env["FW_ELF"]
    ),
)
